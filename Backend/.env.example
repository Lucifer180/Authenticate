# Copy to .env for local development. On Render, add these under
# Service → Environment instead (Render sets PORT itself).

PORT=5000
NODE_ENV=development            # "production" on Render: Secure + SameSite=None cookies

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/authentication
SESSION_SECRET=<long random string>

JWT_ACCESS_SECRET=<long random string>
JWT_ACCESS_EXPIRES_IN=15m

# Allowed browser origins for CORS (scheme + host only, comma-separated).
FRONTEND_ORIGIN=http://localhost:5173
# Full frontend URL including the base path; used for reset-email links and
# OAuth redirects back to the app.
FRONTEND_URL=http://localhost:5173/Authenticate

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials).
# Both callback URLs must be listed as "Authorized redirect URIs" there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_JWT_CALLBACK_URL=http://localhost:5000/api/auth/google/jwt/callback
GOOGLE_APP_JWT_SECRET=<long random string>
GOOGLE_APP_JWT_EXPIRES_IN=15m

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
